#!/usr/bin/env bash
# Segunda barrera tras el .gitignore: bloquea commits con datos personales o secretos.
# Se salta con `git commit --no-verify`: por eso CI (gitleaks) repite la comprobación en el servidor.
fail=0
patron='(\+34 ?)?[6789][0-9]{2} ?[0-9]{2} ?[0-9]{2} ?[0-9]{2}\b|client_secret"?\s*[:=]\s*"?[A-Za-z0-9_-]{8}|gho_[A-Za-z0-9]{20}|ya29\.|1//0[A-Za-z0-9_-]{20}|-----BEGIN [A-Z ]*PRIVATE KEY|AKIA[0-9A-Z]{16}|ghp_[A-Za-z0-9]{30}|github_pat_[A-Za-z0-9_]{20}|xox[abp]-[A-Za-z0-9-]{10}|sk-[A-Za-z0-9_-]{20}|AIza[0-9A-Za-z_-]{35}'
# -z: nombres con espacios o caracteres raros no rompen el bucle
while IFS= read -r -d '' f; do
  case "$f" in
    *.pdf|*.docx|*.xlsx|*.sqlite|*.csv|.env|*/.env|*token*.json|*credentials*.json|*client_secret*|secretos/*|data/*|output/*|logs/*)
      echo "BLOQUEADO (tipo de archivo sensible): $f"; fail=1; continue;;
  esac
  if git show ":$f" | grep -aEi "$patron" >/dev/null; then
    echo "BLOQUEADO (posible secreto o telefono): $f"; fail=1
  fi
done < <(git diff --cached --name-only --diff-filter=ACM -z)
[ $fail -eq 0 ] || { echo "Commit cancelado. Revisa los archivos de arriba."; exit 1; }
