# Lista blanca: se ignora TODO y solo se permite lo que es codigo o plantilla sin datos personales.
# Nunca añadir aqui cv/cv_base.yaml, data/, output/, logs/, .env, tokens ni config/profile.yaml
# (solo las plantillas de ejemplo cv/cv_base.example.yaml y config/profile.example.yaml).
/*
!/.gitignore
!/.gitattributes
!/README.md
!/requirements.txt
!/.env.example
!/diario.bat
!/instalar_tarea.ps1

!/.claude/
/.claude/*
!/.claude/agents/
!/.claude/commands/
!/.claude/settings.json

!/src/
!/githooks/

!/config/
/config/*
!/config/profile.example.yaml

!/cv/
/cv/*
!/cv/cv_base.example.yaml

!/plantillas/

__pycache__/
*.pyc
